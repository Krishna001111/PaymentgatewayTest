generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  CLOSED
}

enum OrderStatus {
  QUOTATION
  CONFIRMED
  IN_PRODUCTION
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum StockReason {
  PRODUCTION
  SALE
  ADJUSTMENT
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id                String          @id @default(cuid())
  name              String
  slug              String          @unique
  partNumber        String          @unique
  description       String
  specs             String? // JSON string of key/value specs
  price             Float?
  hsnCode           String?
  imageUrl          String?
  isPublished       Boolean         @default(true)
  isFeatured        Boolean         @default(false)
  lowStockThreshold Int             @default(10)
  categoryId        String
  category          Category        @relation(fields: [categoryId], references: [id])
  enquiries         Enquiry[]
  orderItems        OrderItem[]
  stockMovements    StockMovement[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Enquiry {
  id        String        @id @default(cuid())
  name      String
  company   String?
  phone     String
  email     String?
  message   String
  status    EnquiryStatus @default(NEW)
  notes     String?
  productId String?
  product   Product?      @relation(fields: [productId], references: [id])
  orders    Order[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  company   String
  phone     String
  email     String?
  gstin     String?
  address   String?
  city      String?
  state     String?
  notes     String?
  orders    Order[]
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(QUOTATION)
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  enquiryId   String?
  enquiry     Enquiry?    @relation(fields: [enquiryId], references: [id])
  items       OrderItem[]
  invoices    Invoice[]
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
}

model StockMovement {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  delta     Int // positive = stock in, negative = stock out
  reason    StockReason
  reference String? // e.g. order number
  note      String?
  createdAt DateTime    @default(now())
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  subtotal      Float
  cgst          Float         @default(0)
  sgst          Float         @default(0)
  igst          Float         @default(0)
  total         Float
  gstRate       Float         @default(18)
  isInterState  Boolean       @default(false)
  paymentStatus PaymentStatus @default(UNPAID)
  payments      Payment[]
  issuedAt      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  method    String // e.g. UPI, NEFT, Cheque, Cash
  reference String?
  paidAt    DateTime @default(now())
}
