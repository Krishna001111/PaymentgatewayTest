# Copy to .env and fill in real values

# Postgres connection string.
# Local dev: postgresql://postgres@localhost:5432/apautoparts
# Production: use the pooled connection string from Neon / Vercel Postgres / Supabase
DATABASE_URL=""

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# The site's URL. http://localhost:3000 for dev; your production domain on Vercel.
NEXTAUTH_URL="http://localhost:3000"

# Optional — set automatically by Vercel when a Blob store is connected.
# When present, product image uploads go to Vercel Blob instead of public/uploads.
# BLOB_READ_WRITE_TOKEN=""
